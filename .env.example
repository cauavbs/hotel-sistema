# Copie para ".env" e preencha. Nunca suba o ".env" nem o firebase-credentials.json para o GitHub.
SECRET_KEY=troque-por-um-valor-aleatorio   # python3 -c "import secrets; print(secrets.token_hex(32))"
FIREBASE_API_KEY=cole-a-chave-da-web-api-do-NOVO-projeto-firebase
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FLASK_DEBUG=true
# Rodando em http://localhost (sem HTTPS), se o login não "grudar":
SESSION_COOKIE_SECURE=false
